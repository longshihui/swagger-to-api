{
  "openapi": "3.0.3",
  "info": {
    "title": "Playground API",
    "version": "1.0.0"
  },
  "paths": {
    "/users/{id}": {
      "get": {
        "operationId": "getUserDetail",
        "summary": "获取用户详情",
        "tags": ["user"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "用户 ID",
            "schema": {
              "type": "string"
            },
            "example": "10001"
          },
          {
            "name": "tenant-id",
            "in": "header",
            "required": false,
            "description": "租户 ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDetail"
                }
              }
            }
          }
        }
      }
    },
    "/users/search": {
      "post": {
        "operationId": "searchUsers",
        "summary": "搜索用户",
        "tags": ["user"],
        "parameters": [
          {
            "name": "pageNum",
            "in": "query",
            "required": false,
            "description": "页码",
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["keyword"],
                "properties": {
                  "keyword": {
                    "type": "string",
                    "description": "搜索关键词"
                  },
                  "status": {
                    "type": "string",
                    "description": "用户状态",
                    "enum": ["enabled", "disabled"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserSummary"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserDetail": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "description": "用户 ID"
          },
          "name": {
            "type": "string",
            "description": "用户名称"
          },
          "status": {
            "type": "string",
            "description": "用户状态",
            "enum": ["enabled", "disabled"]
          }
        }
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "用户 ID"
          },
          "name": {
            "type": "string",
            "description": "用户名称"
          }
        }
      }
    }
  }
}
