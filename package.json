{
  "name": "@lsh/swagger-to-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "test": "vitest run",
    "validate": "pnpm run typecheck && pnpm run lint:eslint && pnpm run test",
    "validate:commit": "pnpm run typecheck && pnpm run lint:eslint:fix",
    "release": "release-it --ci",
    "commit": "GIT_CONFIG_GLOBAL=${GIT_CONFIG_GLOBAL:-$HOME/.gitconfig} HOME=.cache czg",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "playground:validate": "pnpm --filter @lsh/swagger-to-api-playground run validate",
    "playground:generate": "pnpm --filter @lsh/swagger-to-api-playground run generate",
    "playground:docs:dev": "pnpm --filter @lsh/swagger-to-api-playground run docs:dev",
    "playground:docs:build": "pnpm --filter @lsh/swagger-to-api-playground run docs:build"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.28.0",
    "@release-it/bumper": "^7.0.5",
    "@release-it/conventional-changelog": "^10.0.1",
    "czg": "^1.13.1",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "release-it": "^18.1.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.2"
  }
}
